# Yerel güncelleme: "mkosi sysupdate -- update --reboot" mkosi.output'tan alır.
# Kurulu sistemin kendi tanımları /usr/lib/sysupdate.d altındadır.

[Transfer]
ProtectVersion=%A

[Source]
Type=regular-file
Path=/
PathRelativeTo=explicit
MatchPattern=%M_@v_%a.usr-%a.@u.raw

[Target]
Type=partition
Path=auto
MatchPattern=%M_@v
MatchPartitionType=usr
PartitionFlags=0
ReadOnly=1
